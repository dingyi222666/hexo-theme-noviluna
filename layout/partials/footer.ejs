<%
  var f = theme.footer || {};
  var ccMap = {
    'CC BY 4.0': 'by/4.0/',
    'CC BY-SA 4.0': 'by-sa/4.0/',
    'CC BY-NC 4.0': 'by-nc/4.0/',
    'CC BY-NC-SA 4.0': 'by-nc-sa/4.0/',
    'CC BY-ND 4.0': 'by-nd/4.0/',
    'CC BY-NC-ND 4.0': 'by-nc-nd/4.0/'
  };
  var licenseHtml = '';
  if (f.license) {
    var ccPath = ccMap[f.license];
    licenseHtml = ccPath
      ? '<a href="https://creativecommons.org/licenses/' + ccPath + '" target="_blank" rel="noopener">' + f.license + '</a>'
      : f.license;
  }
  // author · powered · ICP share a single line, joined at build time for every
  // language; the client switcher swaps the whole line via data-line-en/zh.
  var meta = footer_meta(f);
  var showLangSwitch = theme.language_switcher !== false;
  // encodeURIComponent(JSON.stringify(args)) — the client decodes both parts.
  function enc(args) { return encodeURIComponent(JSON.stringify(args)); }
%>
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-row">
      <% if (f.copyright !== false) { %>
        <span>&copy; <%= date(new Date(), 'YYYY') %> <%= config.title %></span>
      <% } %>
      <nav class="site-footer-links">
        <a href="<%= url_for('/atom.xml') %>">RSS</a>
        <% if (showLangSwitch) { %>
          <span class="lang-switch">
            <button class="lang-toggle" type="button" data-i18n-aria="lang.switch" aria-label="<%= __('lang.switch') %>">EN/中</button>
            <span class="lang-popover" hidden>
              <button type="button" data-lang="en">English</button>
              <button type="button" data-lang="zh-CN">简体中文</button>
            </span>
          </span>
        <% } %>
      </nav>
    </div>
    <% if (f.license) { %>
      <p class="site-footer-info" data-i18n-fmt="footer.license" data-i18n-args="<%= enc([licenseHtml]) %>"><%- __('footer.license', licenseHtml) %></p>
    <% } %>
    <% if (meta.en || meta['zh-CN']) { %>
      <p class="site-footer-info site-footer-meta"
         data-line-en="<%= encodeURIComponent(meta.en) %>"
         data-line-zh="<%= encodeURIComponent(meta['zh-CN']) %>"><%- meta.current %></p>
    <% } %>
    <% if (theme.busuanzi && theme.busuanzi.enable && theme.busuanzi.site_uv) { %>
      <p class="site-footer-info"><span id="busuanzi_container_site_uv" hidden><span id="busuanzi_value_site_uv"></span> visitors</span></p>
    <% } %>
  </div>
</footer>
<% if (theme.search && theme.search.enable) { %>
  <div class="search-overlay" hidden>
    <button class="search-close" type="button" data-i18n-aria="search.close" aria-label="<%= __('search.close') %>">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="search-box">
      <input class="search-input" type="text" placeholder="<%= __('search.placeholder') %>" autocomplete="off" spellcheck="false">
      <div class="search-results"></div>
    </div>
  </div>
<% } %>
<% if (theme.busuanzi && theme.busuanzi.enable) { %>
  <script async src="<%= theme.busuanzi.src %>"></script>
<% } %>
<%- js('js/main.js') %>
<% if (showLangSwitch) { %>
  <%- js('js/lang.js') %>
<% } %>
