<%
  // The language the site itself is built in.
  var siteLang = String(config.language || 'en').indexOf('zh') === 0 ? 'zh-CN' : 'en';
  // Adapt the UI language to the browser unless the theme opts out.
  var autoLang = theme.language_auto !== false;
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <script>
    (function () {
      var root = document.documentElement;

      // --- colour scheme, before first paint ---
      var t;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') {
        t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      root.setAttribute('data-theme', t);

      // --- UI language, also before first paint ---
      // A stored choice wins; otherwise fall back to the browser language
      // (when enabled) and finally to the language the site is built in.
      // Resolving here means an auto-detected language never flashes the
      // site language first: the page stays hidden until lang.js has
      // swapped the strings.
      var site = <%- JSON.stringify(siteLang) %>;
      var pick = null;
      try { pick = localStorage.getItem('lang'); } catch (e) {}
      if (pick !== 'en' && pick !== 'zh-CN') {
        pick = site;
        <% if (autoLang) { %>
        var list = (navigator.languages && navigator.languages.length)
          ? navigator.languages : [navigator.language || ''];
        for (var i = 0; i < list.length; i++) {
          var s = String(list[i]).toLowerCase();
          if (s.indexOf('zh') === 0) { pick = 'zh-CN'; break; }
          if (s.indexOf('en') === 0) { pick = 'en'; break; }
        }
        <% } %>
      }
      root.setAttribute('lang', pick);
      window.__NOVILUNA_LANG__ = pick;
      if (pick !== site) {
        root.className += ' i18n-pending';
        // Safety net: never leave the page hidden if lang.js fails to load.
        setTimeout(function () {
          root.className = root.className.replace(/\s*i18n-pending/, '');
        }, 1500);
      }
    })();
  </script>
  <%
    var title = page.title ? page.title + ' — ' + config.title : config.title;
    var description = page.description || config.description || '';
    // Both languages dumped for the client-side language toggle.
    var i18nDump = i18n_langs();
  %>
  <title><%= title %></title>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (config.author) { %><meta name="author" content="<%= config.author %>"><% } %>
  <% var favicon = theme.favicon || config.favicon; %>
  <% if (favicon) { %><link rel="icon" href="<%= url_for(favicon) %>"><% } %>
  <link rel="alternate" href="<%= url_for('/atom.xml') %>" type="application/atom+xml" title="<%= config.title %>">
  <% var fonts = theme.fonts || {}; %>
  <% if (fonts.geist !== false || fonts.harmonyos !== false) { %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <% } %>
  <% if (fonts.geist !== false) { %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap">
  <% } %>
  <% if (fonts.harmonyos !== false) { %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/harmonyos-sans-webfont-splitted@1.2.1/dist/HarmonyOS_Sans_SC/index.css">
  <% } %>
  <%- css('css/noviluna') %>
  <script>
    window.__NOVILUNA_LANGS__ = <%- JSON.stringify(i18nDump) %>;
    window.__NOVILUNA_DEFAULT_LANG__ = <%- JSON.stringify(siteLang) %>;
    window.__NOVILUNA_I18N__ = {
      searchPlaceholder: <%- JSON.stringify(__('search.placeholder')) %>,
      noResults: <%- JSON.stringify(__('search.no_results')) %>,
      searchUrl: <%- JSON.stringify(url_for('/search.json')) %>
    };
  </script>
</head>
