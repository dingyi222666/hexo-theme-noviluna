<%
  var nav = (theme.nav && theme.nav.length) ? theme.nav : [
    { label: 'Blog', url: '/' },
    { label: 'Archives', url: '/archives/' },
    { label: 'Tags', url: '/tags/' },
    { label: 'Categories', url: '/categories/' },
    { label: 'About', url: '/about/' },
    { label: 'Links', url: '/links/' }
  ];
  // Translate stock labels through the nav.* i18n keys.
  var navKeys = { Blog: 'nav.blog', Archives: 'nav.archives', Tags: 'nav.tags', Categories: 'nav.categories', About: 'nav.about', Links: 'nav.links' };
  nav.forEach(function (item) {
    if (navKeys[item.label]) {
      item.key = navKeys[item.label];
      item.label = __(item.key);
    }
  });
%>
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-title" href="<%= url_for('/') %>"><%= config.title %></a>
    <nav class="site-nav">
      <div class="site-nav-links" id="site-nav-links">
        <% nav.forEach(function (item, i) { %>
          <a href="<%= url_for(item.url) %>"<% if (item.key) { %> data-i18n="<%= item.key %>"<% } %>><%= item.label %></a>
        <% }); %>
      </div>
      <button class="nav-toggle" type="button" data-i18n-aria="nav.menu" aria-label="<%= __('nav.menu') %>" aria-expanded="false" aria-controls="site-nav-links">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
      <% if (theme.search && theme.search.enable) { %>
        <button class="search-toggle" type="button" aria-label="<%= __('search.placeholder') %>">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.3-4.3"></path>
          </svg>
        </button>
      <% } %>
      <button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
