<article class="post">
  <header class="article-header">
    <h1 class="article-title" data-i18n="nav.categories"><%= __('nav.categories') %></h1>
  </header>
</article>

<section class="chip-list">
  <% site.categories.sort('length', -1).each(function (cat) { %>
    <a class="chip" href="<%= url_for(cat.path) %>">
      <span class="chip-name"><%= cat.name %></span>
      <span class="chip-count"><%= cat.length %></span>
    </a>
  <% }); %>
</section>
