<article class="post">
  <header class="article-header">
    <h1 class="article-title" data-i18n="nav.tags"><%= __('nav.tags') %></h1>
  </header>
</article>

<section class="chip-list">
  <% site.tags.sort('length', -1).each(function (tag) { %>
    <a class="chip" href="<%= url_for(tag.path) %>">
      <span class="chip-name"><%= tag.name %></span>
      <span class="chip-count"><%= tag.length %></span>
    </a>
  <% }); %>
</section>
