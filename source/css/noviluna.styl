// Noviluna — minimal blog theme
// Spec: research/DESIGN-SPEC.md §4
// Design: quiet, typographic minimalism.

// ---------------------------------------------------------------
// §4.1 Tokens — light (Geist register)
//
// Pure white pages over a cool neutral gray scale. Elevation comes from
// hairlines and spacing, never from a tinted surface — a washed-out page
// colour is what makes a palette read as muddy. Borders are black at 8%,
// so a divider tints whatever it crosses instead of asserting its own hue.
// ---------------------------------------------------------------
:root
  // color — light
  --bg            #FFFFFF
  --bg-elevated   #F2F2F2
  --bg-hover      #F2F2F2
  --fg            #171717
  --fg-muted      rgba(23, 23, 23, 0.62)
  --fg-faint      rgba(23, 23, 23, 0.42)
  --border        rgba(0, 0, 0, 0.08)
  --border-strong rgba(0, 0, 0, 0.20)
  --accent        #006BFF
  --hljs-keyword  #BD2864
  --hljs-string   #297A3A
  --hljs-number   #0068D6
  --hljs-title    #7820BC
  --hljs-variable #CB2A2F
  --mark-bg       rgba(255, 212, 0, 0.32)
  --alert-note      #0969DA
  --alert-tip       #1A7F37
  --alert-important #8250DF
  --alert-warning   #9A6700
  --alert-caution   #CF222E
  color-scheme    light

  // type
  --font-sans "Geist", "HarmonyOS Sans SC", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif
  --font-mono "Geist Mono", ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace

  --text-xs   0.8125rem   // 13px captions
  --text-sm   0.875rem    // 14px meta
  --text-base 1rem        // 16px UI
  --text-lg   1.125rem    // 18px
  --text-xl   1.375rem    // 22px card titles
  --text-2xl  1.75rem     // 28px
  --text-3xl  clamp(2rem, 1.4rem + 2.2vw, 2.75rem)  // 32→44px article H1

  --leading-body 1.625
  --leading-tight 1.2
  --track-tight -0.02em
  --track-body  -0.005em

  // spacing — 4px base
  --sp-1  0.25rem
  --sp-2  0.5rem
  --sp-3  0.75rem
  --sp-4  1rem
  --sp-5  1.25rem
  --sp-6  1.5rem
  --sp-8  2rem
  --sp-12 3rem
  --sp-16 4rem
  --sp-24 6rem

  // layout
  --header-h   56px
  --container  1080px
  --prose      720px
  --prose-wide 980px
  --toc-w      200px
  --radius     6px
  --radius-pill 999px

  --transition 150ms ease

// Dark — Geist register: a pure black page, porcelain ink, and hairlines
// that brighten (white at 14%) instead of tinting.
// Explicit attribute
[data-theme="dark"]
  color-scheme dark

// Dark — media query default when no explicit attribute
@media (prefers-color-scheme: dark)
  :root:not([data-theme="light"])
    color-scheme dark

[data-theme="dark"]
  --bg            #000000
  --bg-elevated   #1A1A1A
  --bg-hover      #1A1A1A
  --fg            #EDEDED
  --fg-muted      rgba(237, 237, 237, 0.62)
  --fg-faint      rgba(237, 237, 237, 0.44)
  --border        rgba(255, 255, 255, 0.14)
  --border-strong rgba(255, 255, 255, 0.28)
  --accent        #47A8FF
  --hljs-keyword  #F75F8F
  --hljs-string   #62C073
  --hljs-number   #52A8FF
  --hljs-title    #BF7AF0
  --hljs-variable #FF6166
  --mark-bg       rgba(255, 212, 0, 0.22)
  --alert-note      #4493F8
  --alert-tip       #3FB950
  --alert-important #AB7DF8
  --alert-warning   #D29922
  --alert-caution   #F85149

@media (prefers-color-scheme: dark)
  :root:not([data-theme="light"])
    --bg            #000000
    --bg-elevated   #1A1A1A
    --bg-hover      #1A1A1A
    --fg            #EDEDED
    --fg-muted      rgba(237, 237, 237, 0.62)
    --fg-faint      rgba(237, 237, 237, 0.44)
    --border        rgba(255, 255, 255, 0.14)
    --border-strong rgba(255, 255, 255, 0.28)
    --accent        #47A8FF
    --hljs-keyword  #F75F8F
    --hljs-string   #62C073
    --hljs-number   #52A8FF
    --hljs-title    #BF7AF0
    --hljs-variable #FF6166
    --mark-bg       rgba(255, 212, 0, 0.22)
    --alert-note      #4493F8
    --alert-tip       #3FB950
    --alert-important #AB7DF8
    --alert-warning   #D29922
    --alert-caution   #F85149

// ---------------------------------------------------------------
// §4.2 Base
// ---------------------------------------------------------------
*, *::before, *::after
  box-sizing border-box

html
  font-size 16px
  -webkit-text-size-adjust 100%

// Set by the inline script in head.ejs when the UI language differs from the
// language the page was built in: keeps the server-rendered strings out of
// sight until lang.js has swapped them, so nothing flashes. A timeout in that
// same script clears it if lang.js never runs.
html.i18n-pending body
  visibility hidden

body
  margin 0
  padding 0
  font-family var(--font-sans)
  font-size 1.0625rem              // 17px prose
  line-height var(--leading-body)
  letter-spacing var(--track-body)
  color var(--fg)
  background var(--bg)
  -webkit-font-smoothing antialiased
  -moz-osx-font-smoothing grayscale

img
  max-width 100%
  height auto

// ---------------------------------------------------------------
// Layout shell
// ---------------------------------------------------------------
.site-main
  max-width var(--prose)
  margin 0 auto
  padding calc(var(--header-h) + var(--sp-12)) var(--sp-6) 0

// ---------------------------------------------------------------
// §4.3 Header — fixed flat bar, border only when scrolled
// ---------------------------------------------------------------
.site-header
  position fixed
  top 0
  left 0
  right 0
  z-index 100
  height var(--header-h)
  background var(--bg)
  border-bottom 1px solid transparent
  transition border-color var(--transition)

  &.scrolled
    border-bottom-color var(--border)

.site-header-inner
  max-width var(--container)
  height 100%
  margin 0 auto
  padding 0 var(--sp-6)
  display flex
  align-items center
  justify-content space-between

.site-title
  font-size var(--text-base)
  font-weight 600
  letter-spacing -0.01em
  color var(--fg)
  text-decoration none

.site-nav
  display flex
  align-items center
  gap var(--sp-6)

  a
    font-size var(--text-sm)
    font-weight 500
    color var(--fg-muted)
    text-decoration none
    transition color var(--transition)

    &:hover
      color var(--fg)

.site-nav-links
  display flex
  align-items center
  gap var(--sp-6)

// Hamburger — only shown on narrow viewports (see the ≤640px block below).
.nav-toggle
  display none
  appearance none
  background none
  border 0
  padding 0
  margin-left var(--sp-2)
  color var(--fg-muted)
  cursor pointer
  transition color var(--transition)

  &:hover
    color var(--fg)

  svg
    display block

.theme-toggle
  appearance none
  background none
  border 0
  padding 0
  margin-left var(--sp-2)
  font-family var(--font-sans)
  font-size var(--text-sm)
  font-weight 500
  color var(--fg-muted)
  cursor pointer
  transition color var(--transition)

  &:hover
    color var(--fg)

  svg
    display block
    width 18px
    height 18px

// ---------------------------------------------------------------
// §4.4 Footer
// ---------------------------------------------------------------
.site-footer
  margin-top var(--sp-24)
  border-top 1px solid var(--border)

.site-footer-inner
  max-width var(--prose)
  margin 0 auto
  padding var(--sp-6)
  font-size var(--text-sm)
  color var(--fg-muted)

  a
    color var(--fg-muted)
    text-decoration none
    transition color var(--transition)

    &:hover
      color var(--fg)

.site-footer-row
  display flex
  align-items baseline
  justify-content space-between
  flex-wrap wrap
  gap var(--sp-3)

.site-footer-links
  display flex
  align-items baseline
  gap var(--sp-5)

// ---------------------------------------------------------------
// Index — archive rows
// ---------------------------------------------------------------
.post-list
  max-width var(--prose)
  margin 0 auto

.post-row
  display grid
  grid-template-columns 10ch minmax(0, 1fr)
  gap var(--sp-4)
  align-items baseline
  padding var(--sp-5) var(--sp-3)
  margin 0 calc(var(--sp-3) * -1)   // hover bg bleeds slightly past column
  border-top 1px solid var(--border)  // first row too
  text-decoration none
  transition background var(--transition)

  &:hover
    background var(--bg-hover)

.post-row-date
  font-size var(--text-sm)
  color var(--fg-faint)
  font-variant-numeric tabular-nums
  white-space nowrap

.post-row-body
  min-width 0

.post-row-title
  font-size 1.0625rem
  font-weight 500
  letter-spacing -0.01em
  line-height 1.45
  color var(--fg)
  margin 0

.post-row-excerpt
  display block
  font-size var(--text-sm)
  color var(--fg-muted)
  margin var(--sp-1) 0 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

// ---------------------------------------------------------------
// §4.2 Prose typography
// ---------------------------------------------------------------
.prose
  max-width var(--prose)
  margin-inline auto

  > *:first-child
    margin-top 0

  > *:last-child
    margin-bottom 0

  p
    margin 0 0 var(--sp-6)

  h2
    font-size var(--text-2xl)
    line-height 1.32
    letter-spacing var(--track-tight)
    font-weight 500
    margin var(--sp-12) 0 var(--sp-4)

  h3
    font-size var(--text-xl)
    font-weight 500
    letter-spacing -0.01em
    margin var(--sp-8) 0 var(--sp-3)

  h4
    font-size 1.0625rem
    font-weight 600
    letter-spacing -0.01em
    margin var(--sp-8) 0 var(--sp-3)

  h5
    font-size var(--text-base)
    font-weight 600
    margin var(--sp-6) 0 var(--sp-2)

  h6
    font-size var(--text-sm)
    font-weight 600
    color var(--fg-muted)
    margin var(--sp-6) 0 var(--sp-2)

  a
    color var(--fg)
    text-decoration underline 1px var(--fg-faint)
    text-underline-offset 2px
    transition text-decoration-color var(--transition)

    &:hover
      text-decoration-color var(--fg)

  // hexo-renderer-marked heading anchors — keep headings clean
  .headerlink
    display none

  img
    width 100%
    border-radius var(--radius)
    margin var(--sp-8) 0

  ul, ol
    margin 0 0 var(--sp-6)
    padding-left var(--sp-6)

    ul, ol
      margin var(--sp-2) 0

  li
    margin-bottom var(--sp-2)

    &::marker
      color var(--fg-faint)

    > input[type="checkbox"]
      appearance auto
      accent-color var(--accent)
      margin 0 var(--sp-2) 0 calc(var(--sp-5) * -1)
      vertical-align -1px

  mark
    background var(--mark-bg)
    color var(--fg)
    padding 0 2px
    border-radius 2px

  kbd
    font-family var(--font-mono)
    font-size 0.75rem
    background var(--bg-elevated)
    border 1px solid var(--border-strong)
    border-bottom-width 2px
    border-radius 3px
    padding 1px 5px

  // GitHub Alerts — rendered natively by markdown-it-github-alerts
  // (``> [!NOTE]`` and friends). Output markup matches GitHub's, including
  // the octicon in the title, so the class names below are theirs.
  .markdown-alert
    --alert-color var(--fg-muted)
    margin 0 0 var(--sp-6)
    padding var(--sp-4) var(--sp-5)
    border-left 3px solid var(--alert-color)
    border-radius 0 var(--radius) var(--radius) 0
    background s('color-mix(in srgb, %s 6%%, transparent)', var(--alert-color))

    .markdown-alert-title
      display flex
      align-items center
      gap var(--sp-2)
      margin 0 0 var(--sp-2)
      font-size var(--text-sm)
      font-weight 600
      line-height 1.4
      color var(--alert-color)

      svg
        flex none
        width 16px
        height 16px
        fill currentColor

    > :last-child
      margin-bottom 0

  .markdown-alert-note
    --alert-color var(--alert-note)

  .markdown-alert-tip
    --alert-color var(--alert-tip)

  .markdown-alert-important
    --alert-color var(--alert-important)

  .markdown-alert-warning
    --alert-color var(--alert-warning)

  .markdown-alert-caution
    --alert-color var(--alert-caution)

  // Folding — plain GFM <details> markup
  details
    margin 0 0 var(--sp-6)
    padding var(--sp-3) var(--sp-4)
    border 1px solid var(--border)
    border-radius var(--radius)

    summary
      margin calc(var(--sp-3) * -1) calc(var(--sp-4) * -1)
      padding var(--sp-3) var(--sp-4)
      font-weight 500
      cursor pointer

    &[open] summary
      margin-bottom var(--sp-4)
      border-bottom 1px solid var(--border)

    > :last-child
      margin-bottom 0

  // Footnotes — markdown-it-footnote
  .footnotes-sep
    margin var(--sp-12) 0 var(--sp-6)
    border 0
    border-top 1px solid var(--border)

  .footnotes
    font-size var(--text-sm)
    color var(--fg-muted)

    .footnotes-list
      padding-left var(--sp-6)

    .footnote-item
      margin-bottom var(--sp-2)

      p
        margin 0

    .footnote-ref a
      text-decoration none

    .footnote-backref
      text-decoration none

  table
    width 100%
    border-collapse collapse
    margin 0 0 var(--sp-6)
    font-size var(--text-sm)
    display block
    overflow-x auto

    thead, tbody, tr
      width 100%

  th, td
    padding 10px 12px
    text-align left
    border-bottom 1px solid var(--border)

  th
    font-size var(--text-sm)
    font-weight 500
    color var(--fg-muted)
    white-space nowrap

  figure
    margin var(--sp-8) 0

    img
      margin 0 0 var(--sp-2)

  figcaption
    font-size var(--text-xs)
    color var(--fg-faint)
    text-align center

  sup
    font-size 0.75em

  // footnotes section (hexo-renderer-marked)
  .footnotes
    font-size var(--text-xs)
    color var(--fg-muted)
    border-top 1px solid var(--border)
    margin-top var(--sp-12)
    padding-top var(--sp-4)

    ol
      padding-left var(--sp-5)
      margin 0

    a
      text-decoration none

  dl
    margin 0 0 var(--sp-6)

  dt
    font-weight 500
    margin-top var(--sp-3)

  dd
    margin 0 0 var(--sp-2) var(--sp-5)
    color var(--fg-muted)

  blockquote
    margin 0 0 var(--sp-6)
    padding var(--sp-1) 0 var(--sp-1) var(--sp-5)
    border-left 2px solid var(--border-strong)
    color var(--fg-muted)

    p:last-child
      margin-bottom 0

  hr
    border 0
    border-top 1px solid var(--border)
    margin var(--sp-12) 0

  pre
    font-family var(--font-mono)
    font-size var(--text-sm)
    line-height 1.6
    background var(--bg-elevated)
    border 1px solid var(--border)
    border-radius var(--radius)
    padding var(--sp-4)
    overflow-x auto
    margin 0 0 var(--sp-6)

    code
      background transparent
      border-radius 0
      padding 0
      font-size inherit

  code:not(pre code)
    font-family var(--font-mono)
    font-size 0.875em
    background var(--bg-elevated)
    border-radius 4px
    padding 0.1em 0.35em

  // Hexo highlight.js wrapper
  .highlight
    background var(--bg-elevated)
    border 1px solid var(--border)
    border-radius var(--radius)
    padding var(--sp-4)
    margin 0 0 var(--sp-6)
    overflow-x auto
    font-size var(--text-sm)
    line-height 1.6

    pre
      background transparent
      border 0
      border-radius 0
      padding 0
      margin 0

    table, tr, td
      border 0
      margin 0
      padding 0

// ---------------------------------------------------------------
// Syntax highlighting — quiet palette derived from the theme tokens.
// Deliberately low-contrast: structure over rainbow.
//
// Hexo runs highlight.js when `highlight.hljs: true`, which emits the
// prefixed names (`hljs-keyword`). The unprefixed ones are Hexo's own
// tokenizer names, kept so the palette survives either setting.
// ---------------------------------------------------------------
.highlight
  .hljs-comment, .hljs-quote,
  .comment, .quote
    color var(--fg-faint)
    font-style normal

  .hljs-keyword, .hljs-selector-tag, .hljs-type, .hljs-built_in, .hljs-literal,
  .keyword, .selector-tag, .type, .built_in
    color var(--hljs-keyword)

  .hljs-string, .hljs-regexp, .hljs-addition, .hljs-meta-string, .hljs-template-tag,
  .string, .regexp, .addition, .meta-string
    color var(--hljs-string)

  .hljs-number, .hljs-symbol, .hljs-bullet,
  .number, .literal, .symbol
    color var(--hljs-number)

  .hljs-title, .hljs-name, .hljs-section, .hljs-selector-id, .hljs-selector-class,
  .hljs-property, .hljs-attr, .hljs-attribute, .hljs-params,
  .title, .name, .section, .attr, .attribute
    color var(--hljs-title)
    font-weight 500

  .hljs-variable, .hljs-template-variable,
  .variable, .template-variable
    color var(--hljs-variable)

  .hljs-meta, .hljs-deletion, .hljs-link, .hljs-emphasis,
  .meta, .deletion, .link, .emphasis
    color var(--fg-muted)

  .hljs-strong,
  .strong
    font-weight 600

// ---------------------------------------------------------------
// Article header (post + page)
// ---------------------------------------------------------------
.article-header
  max-width var(--prose)
  margin 0 auto var(--sp-12)
  text-align center

.article-title
  font-size var(--text-3xl)
  line-height var(--leading-tight)
  font-weight 500
  letter-spacing var(--track-tight)
  margin 0 auto var(--sp-6)
  max-width 20ch

.article-meta
  font-size var(--text-sm)
  font-weight 500
  color var(--fg-muted)
  margin 0

  a
    color inherit
    text-decoration none

    &:hover
      color var(--fg)

.article-tags
  font-size var(--text-xs)
  color var(--fg-faint)
  margin var(--sp-2) 0 0

.article-extras
  font-size var(--text-xs)
  color var(--fg-faint)
  font-variant-numeric tabular-nums
  margin var(--sp-2) 0 0

// ---------------------------------------------------------------
// Prev / next post nav
// ---------------------------------------------------------------
.post-nav
  max-width var(--prose)
  margin var(--sp-16) auto 0
  padding-top var(--sp-6)
  border-top 1px solid var(--border)
  display flex
  justify-content space-between
  gap var(--sp-4)
  font-size var(--text-sm)

  a
    color var(--fg-muted)
    text-decoration none
    transition color var(--transition)

    &:hover
      color var(--fg)

// ---------------------------------------------------------------
// Pagination (index)
// ---------------------------------------------------------------
.pagination
  max-width var(--prose)
  margin var(--sp-8) auto 0
  padding-top var(--sp-6)
  border-top 1px solid var(--border)
  display flex
  justify-content space-between
  gap var(--sp-4)
  font-size var(--text-sm)

  a
    color var(--fg-muted)
    text-decoration none
    transition color var(--transition)

    &:hover
      color var(--fg)

// ---------------------------------------------------------------
// Archive — year groups + same row pattern
// ---------------------------------------------------------------
.archive-year
  font-size var(--text-sm)
  font-weight 500
  color var(--fg-muted)
  margin var(--sp-12) 0 var(--sp-2)

  &:first-of-type
    margin-top 0

// ---------------------------------------------------------------
// Mobile ≤640px
// ---------------------------------------------------------------
@media (max-width: 640px)
  .site-header-inner
    padding 0 var(--sp-4)

  .site-nav
    gap var(--sp-4)

  // The inline nav overflows a 390px viewport, so it collapses into a
  // dropdown behind the hamburger.
  .nav-toggle
    display flex

  .site-nav-links
    position absolute
    top 100%
    right var(--sp-4)
    z-index 10
    display none
    flex-direction column
    align-items stretch
    gap 0
    min-width 180px
    padding var(--sp-2)
    background var(--bg)
    border 1px solid var(--border)
    border-radius var(--radius)
    box-shadow 0 8px 24px rgba(0, 0, 0, 0.08)

    &.is-open
      display flex

    a
      padding var(--sp-2) var(--sp-3)
      border-radius 4px

      &:hover
        background var(--bg-hover)

  .site-main
    padding calc(var(--header-h) + var(--sp-8)) var(--sp-4) 0

  .site-footer-inner
    padding var(--sp-6) var(--sp-4)

  .post-row
    grid-template-columns 1fr
    gap var(--sp-3)
    padding var(--sp-5) var(--sp-2)
    margin 0 calc(var(--sp-2) * -1)

  .post-row-title
    font-size var(--text-base)

  .post-row-excerpt
    display none

// ---------------------------------------------------------------
// Article meta extras
// ---------------------------------------------------------------
.article-meta .meta-cat
  color var(--fg-muted)
  text-decoration none
  font-weight 500

  &:hover
    color var(--fg)

// ---------------------------------------------------------------
// Post wrap — optional TOC rail (≥1200px) / wide layout
// ---------------------------------------------------------------
.post-wrap
  max-width var(--prose)
  margin 0 auto
  position relative

  &.is-wide
    max-width var(--prose-wide)

    .article-header
    .prose
      max-width var(--prose-wide)

    // body copy keeps its measure; tables/code/images go full width
    .prose p
    .prose li
    .prose blockquote
      max-width var(--prose)

    .prose table
      width 100%

.toc-rail
  display none

@media (min-width: 1200px)
  .toc-rail
    display block
    position absolute
    left calc(100% + var(--sp-8))
    top 0
    width var(--toc-w)
    height 100%

  .toc-rail-inner
    position sticky
    top calc(var(--header-h) + var(--sp-8))
    max-height calc(100vh - var(--header-h) - var(--sp-16))
    overflow-y auto
    opacity 0
    transition opacity 300ms ease

    &.is-ready
      opacity 1

.toc-heading
  font-size var(--text-xs)
  font-weight 500
  color var(--fg-faint)
  margin 0 0 var(--sp-3)

.toc-body
  .toc
    list-style none
    margin 0
    padding 0

    ol, ul
      list-style none
      margin 0
      padding-left var(--sp-3)

  .toc-item
    line-height 1.9

  // quiet text list: active item is just darker ink, no bars or markers
  a.toc-link
    display block
    font-size var(--text-xs)
    font-weight 400
    color var(--fg-faint)
    text-decoration none
    transition color 200ms ease

    &:hover
      color var(--fg-muted)

    &.is-active
      color var(--fg)
      font-weight 500

// ---------------------------------------------------------------
// Related posts / comments — hairline-separated footer sections
// ---------------------------------------------------------------
.section-heading
  font-size var(--text-sm)
  font-weight 500
  color var(--fg-faint)
  margin 0 0 var(--sp-3)

.related-posts
  max-width var(--prose)
  margin var(--sp-16) auto 0
  padding-top var(--sp-6)
  border-top 1px solid var(--border)

.related-list
  list-style none
  margin 0
  padding 0

  li a
    display grid
    grid-template-columns 11ch minmax(0, 1fr)
    gap var(--sp-4)
    align-items baseline
    padding var(--sp-2) var(--sp-3)
    margin 0 calc(var(--sp-3) * -1)
    text-decoration none
    border-radius var(--radius)
    transition background var(--transition)

    &:hover
      background var(--bg-hover)

    time
      font-size var(--text-xs)
      color var(--fg-faint)
      font-variant-numeric tabular-nums
      white-space nowrap

  .related-title
    font-size 0.9375rem
    color var(--fg)
    letter-spacing -0.01em

.comments
  max-width var(--prose)
  margin var(--sp-16) auto 0
  padding-top var(--sp-6)
  border-top 1px solid var(--border)

// ---------------------------------------------------------------
// Search overlay — huge light input, one hairline
// ---------------------------------------------------------------
.search-toggle
  appearance none
  background none
  border 0
  padding 0
  color var(--fg-muted)
  cursor pointer
  transition color var(--transition)

  &:hover
    color var(--fg)

  svg
    display block

.search-overlay
  position fixed
  inset 0
  z-index 200
  background s('color-mix(in srgb, %s 98%, transparent)', var(--bg))
  backdrop-filter blur(0)
  -webkit-backdrop-filter blur(0)
  opacity 0
  transition opacity 200ms ease, backdrop-filter 200ms ease, -webkit-backdrop-filter 200ms ease

  &[hidden]
    display none

  &.is-open
    opacity 1
    backdrop-filter blur(10px)
    -webkit-backdrop-filter blur(10px)

@keyframes search-fade
  from
    opacity 0
  to
    opacity 1

.search-close
  position absolute
  top var(--sp-5)
  right var(--sp-6)
  display flex
  align-items center
  justify-content center
  width 36px
  height 36px
  padding 0
  appearance none
  background none
  border 0
  border-radius var(--radius-pill)
  color var(--fg-faint)
  cursor pointer
  transition color var(--transition), background var(--transition)

  &:hover
    color var(--fg)
    background var(--bg-hover)

  &:focus-visible
    outline 2px solid var(--accent)
    outline-offset 2px

  svg
    display block

.search-box
  max-width 640px
  margin 25vh auto 0
  padding 0 var(--sp-6)
  opacity 0
  transform translateY(8px)
  transition opacity 220ms ease, transform 220ms ease

.search-overlay.is-open .search-box
  opacity 1
  transform none

@media (prefers-reduced-motion: reduce)
  .search-overlay
  .search-box
    transition none
    transform none
    opacity 1

.search-input
  width 100%
  appearance none
  background transparent
  border 0
  border-bottom 1px solid var(--border-strong)
  border-radius 0
  padding var(--sp-3) 0
  font-family var(--font-sans)
  font-size 2rem               // 32px oversized input
  font-weight 400
  letter-spacing -0.01em
  color var(--fg)
  outline none

  &::placeholder
    color var(--fg-faint)

.search-results
  margin-top var(--sp-6)
  max-height 50vh
  overflow-y auto

.search-row
  display block
  padding var(--sp-4) var(--sp-3)
  margin 0 calc(var(--sp-3) * -1)
  border-top 1px solid var(--border)
  text-decoration none
  transition background var(--transition)

  &:hover
  &.is-active
    background var(--bg-hover)

.search-row-title
  font-size 1.0625rem
  font-weight 500
  letter-spacing -0.01em
  color var(--fg)

.search-empty
  padding var(--sp-4) 0
  font-size var(--text-sm)
  color var(--fg-faint)

@media (max-width: 640px)
  .search-input
    font-size 1.5rem

  .search-box
    margin-top 18vh

// ---------------------------------------------------------------
// Tags / categories — a chip cloud instead of a list
// ---------------------------------------------------------------
.chip-list
  max-width var(--prose)
  margin var(--sp-12) auto 0
  display flex
  flex-wrap wrap
  gap var(--sp-2)

.chip
  display inline-flex
  align-items baseline
  gap var(--sp-2)
  padding var(--sp-1) var(--sp-3)
  border 1px solid var(--border)
  border-radius var(--radius-pill)
  font-size var(--text-sm)
  line-height 1.6
  color var(--fg)
  text-decoration none
  transition border-color var(--transition), background var(--transition)

  &:hover
    background var(--bg-hover)
    border-color var(--border-strong)

  .chip-name
    letter-spacing -0.005em

  .chip-count
    font-size var(--text-xs)
    color var(--fg-faint)
    font-variant-numeric tabular-nums

// ---------------------------------------------------------------
// Links page — friend cards
// ---------------------------------------------------------------
.link-grid
  max-width var(--prose)
  margin var(--sp-12) auto 0
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--sp-3)

.link-card
  display flex
  align-items center
  gap var(--sp-3)
  padding var(--sp-3) var(--sp-4)
  border 1px solid var(--border)
  border-radius var(--radius)
  color var(--fg)
  text-decoration none
  transition border-color var(--transition), background var(--transition)

  &:hover
    background var(--bg-hover)
    border-color var(--border-strong)

.link-avatar
  width 32px
  height 32px
  flex none
  border-radius var(--radius)
  object-fit cover
  border 1px solid var(--border)

.link-card-body
  display flex
  flex-direction column
  gap 2px
  min-width 0

.link-name
  font-size var(--text-base)
  font-weight 500
  letter-spacing -0.01em
  color var(--fg)

.link-desc
  font-size var(--text-xs)
  color var(--fg-faint)
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

@media (max-width 640px)
  .link-grid
    grid-template-columns 1fr

// ---------------------------------------------------------------
// Footer info block — optional faint lines below the footer row
// ---------------------------------------------------------------
.site-footer-info
  margin var(--sp-1) 0 0
  font-size var(--text-xs)
  color var(--fg-faint)

  a
    color inherit
    text-decoration underline 1px var(--fg-faint)
    text-underline-offset 2px

    &:hover
      color var(--fg-muted)

// ---------------------------------------------------------------
// Language switch — footer button + popover
// ---------------------------------------------------------------
.lang-switch
  position relative
  display inline-flex

.lang-toggle
  appearance none
  background none
  border 0
  padding 0
  font-family var(--font-sans)
  font-size var(--text-sm)
  color var(--fg-muted)
  cursor pointer
  transition color var(--transition)

  &:hover
    color var(--fg)

.lang-popover
  position absolute
  bottom calc(100% + var(--sp-2))
  right 0
  display flex
  flex-direction column
  min-width 120px
  padding var(--sp-1)
  background var(--bg)
  border 1px solid var(--border)
  border-radius var(--radius)
  box-shadow 0 4px 16px rgba(0, 0, 0, 0.08)
  animation search-fade 150ms ease

  &[hidden]
    display none

  button
    appearance none
    background none
    border 0
    padding var(--sp-2) var(--sp-3)
    font-family var(--font-sans)
    font-size var(--text-sm)
    color var(--fg-muted)
    text-align left
    cursor pointer
    border-radius calc(var(--radius) - 2px)
    transition background var(--transition), color var(--transition)

    &:hover
      background var(--bg-hover)
      color var(--fg)

    &.is-active
      color var(--fg)
      font-weight 500

// ---------------------------------------------------------------
// Theme switch — circular reveal over the View Transitions snapshot
// (--vt-x/--vt-y/--vt-r are set from the toggle button's position)
// ---------------------------------------------------------------
::view-transition-old(root),
::view-transition-new(root)
  animation none
  mix-blend-mode normal

// Ease-in-out at 620ms: slow off the mark, quick through the middle, soft
// landing — the expansion stays visible the whole way instead of finishing
// in the first 150ms. Only the incoming layer animates; dimming the old one
// greyed the edge.
::view-transition-new(root)
  animation 620ms cubic-bezier(.45, 0, .15, 1) both nv-reveal

@keyframes nv-reveal
  from
    clip-path circle(0 at var(--vt-x, 50%) var(--vt-y, 50%))
  to
    clip-path circle(var(--vt-r, 150vmax) at var(--vt-x, 50%) var(--vt-y, 50%))

@media (prefers-reduced-motion: reduce)
  ::view-transition-new(root)
    animation none
